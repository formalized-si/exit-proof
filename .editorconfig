root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{py,rs}]
indent_size = 4

# Left exactly as they are. Four directories are pinned in the on-chain registry by a hash of their contents:
# a change of one byte, formatting included, ends the match (docs/DEVELOPMENT.md). Records of runs are written
# by the runs.
[{pool-proof,wnear-proof,token-standard,upgrade-window}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset

[{evidence,registry/certificates}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset

[**/evidence/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
